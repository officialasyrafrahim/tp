@startuml
!pragma layout smetana
title Calendar dashboard collaborators
skinparam backgroundColor white
skinparam shadowing false
skinparam defaultFontName SansSerif
skinparam defaultFontSize 14
skinparam classAttributeIconSize 0
skinparam classBackgroundColor #EDF3F8
skinparam classBorderColor #526477
skinparam ArrowColor #526477
hide circle
hide empty members

abstract class Command {
  {abstract} +execute(...): CommandResult
}
class Parser {
  +parse(input: String): Command
}
class ViewCommand {
  -clock: Clock
  +execute(...): CommandResult
}
enum "ViewCommand.Range" as Range <<enumeration>> {
  TODAY
  TOMORROW
  WEEK
}
class ActivityList {
  +getViewBetween(...): List<Activity>
}
class Activity {
  +getDate(): LocalDate
  +isDone(): boolean
  +getPriorityScore(): Integer
}
Command <|-- ViewCommand
Parser ..> ViewCommand : creates with range and clock
ViewCommand --> Range : selected period
ViewCommand ..> ActivityList : queries inclusive dates
ViewCommand ..> Activity : reads schedule and ratings
ActivityList --> "0..*" Activity : activities
note bottom of ViewCommand
  Groups activities by date and formats summaries.
  Returns a read-only CommandResult.
end note
@enduml
