@startuml
title Validate an activity schedule before insertion or replacement
skinparam backgroundColor white
skinparam shadowing false
skinparam defaultFontName SansSerif
skinparam defaultFontSize 14
skinparam ParticipantBackgroundColor #EDF3F8
skinparam ParticipantBorderColor #526477
skinparam ArrowColor #526477
skinparam sequenceMessageAlign center
hide footbox

actor "User" as User
participant "ui:Ui" as UI
participant "ConsoleHelper" as Console <<class>>
participant "add:AddCommand" as Add
participant "ActivityScheduleValidator" as Validator <<class>>
participant "activities:ActivityList" as Activities

Console -> UI : readLine()
User -> UI : add ...
UI --> Console : input

Console -> Add : execute(activities, storage)
Add -> Validator : validate(...)
Validator -> Activities : getCanonicalView()
Activities --> Validator : chronological activities
note over Validator, Activities
  Check duplicate identity first.
  Use full chronological indexes.
end note

alt duplicate identity exists
  Validator --> Add : duplicate warning
  Add --> Console : propagate warning
  Console -> UI : showMessage(warning)
  UI --> User : warning
else no duplicate
  alt isOverlapAllowed is true
    Validator --> Add : validation passed
  else same-date positive overlap exists
    note over Validator, Activities
      Check positive time overlap.
      Touching endpoints are allowed.
    end note
    Validator --> Add : clash warning and overlap/ALLOW hint
    Add --> Console : propagate warning
    Console -> UI : showMessage(warning)
    UI --> User : warning
  else no clash
    Validator --> Add : validation passed
  end
end

opt validation passed
  Add -> Activities : addActivity(candidate)
  Activities --> Add : activity inserted
  Add --> Console : CommandResult(message, false, true)
  ref over User, Console
  CompletionAndSaveSequence
  result, activities, storage
end ref
  note over Console, Activities
    The shared automatic-save and display flow follows insertion.
    Validation itself performs no mutation or file I/O.
  end note
end

note over Add, Validator
  An edit excludes its original activity.
  Name/schedule edits validate before replacement.
  Demand/rating-only edits skip conflict checking.
  overlap/ALLOW permits clashes.
  Duplicate checks always apply.
end note
@enduml
