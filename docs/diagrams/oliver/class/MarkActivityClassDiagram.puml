@startuml
!pragma layout smetana
title Mark an activity as completed
skinparam backgroundColor white
skinparam shadowing false
skinparam defaultFontName SansSerif
skinparam defaultFontSize 14
skinparam ArrowColor #526477
skinparam classAttributeIconSize 0
skinparam classBackgroundColor #EDF3F8
skinparam classBorderColor #526477
hide circle
hide empty members

abstract class Command {
  {abstract} +execute(...): CommandResult
}
class Parser {
  +parse(input: String): Command
}
class MarkCommandParser {
  +parseMark(words: String[]): Command
}
class MarkCommand {
  -displayedIndex: int
  +MarkCommand(displayedIndex: int)
  +execute(...): CommandResult
}
class ActivityList {
  +getByDisplayedIndex(displayedIndex: int): Activity
  +setDoneAtDisplayedIndex(displayedIndex: int, isDone: boolean): boolean
}
class Activity {
  +getName(): String
  +isDone(): boolean
  +setDone(isDone: boolean): void
}
class CommandResult {
  +getMessage(): String
  +didChangeActivities(): boolean
}
Command <|-- MarkCommand
Parser *-- MarkCommandParser : delegates command syntax
MarkCommandParser ..> MarkCommand : creates with index
MarkCommand ..> ActivityList : requests isDone = true
MarkCommand ..> CommandResult : reports whether state changed
ActivityList --> "0..*" Activity : activities
note bottom of ActivityList
  Resolve the full chronological list index.
  Return false if completion already matches the request.
  Otherwise update the activity and return true.
end note
note bottom of CommandResult
  ConsoleHelper saves only when the completion state changes.
  A repeated request returns a warning without saving.
  Invalid indexes leave the original activity unchanged.
end note
@enduml
