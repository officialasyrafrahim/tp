@startuml
!pragma layout smetana

title UniEnable architecture
top to bottom direction
skinparam backgroundColor white
skinparam shadowing false
skinparam defaultFontName SansSerif
skinparam defaultFontSize 14
skinparam componentStyle rectangle
skinparam componentBackgroundColor #EDF3F8
skinparam componentBorderColor #526477
skinparam ArrowColor #526477
skinparam nodesep 45
skinparam ranksep 50

component "Application\nUniEnable / ConsoleHelper" as Console #E3EFFB
component "Terminal UI\nUi / output formatters" as UI #E3EFFB
component "Parsing\nParser / command parsers" as Parsing #EEE5F7
component "Commands\nCommand / CommandResult / feature commands" as Commands #EEE5F7
component "Storage\nStorage / FacilityStorage / ConnectionStorage" as Storage #FFF0DC
component "Accessibility logic\nFacilityManager / ConnectionManager\nDijkstraShortestPath / DijkstraSolver" as Accessibility #EEE5F7
component "Models\nActivityList / Activity\nFacility / FacilityFeature / Connection" as Models #E5F2E4

Console ..> UI : read / display
Console ..> Parsing : parse input
Console ..> Commands : execute
Console ..> Storage : load / save changes / retry on exit
Parsing ..> Commands : create
Commands ..> Models : read / update activities
Commands ..> Accessibility : query
Commands ..> UI : format list and facility results
Accessibility ..> Models : read reference data
Storage ..> Models : load records / save activities

legend bottom
  |= Colour |= Responsibility |
  |<#E3EFFB> Light blue | Application and terminal UI |
  |<#EEE5F7> Light purple | Parsing, commands and accessibility logic |
  |<#E5F2E4> Light green | Models |
  |<#FFF0DC> Light orange | Storage |
endlegend

@enduml
