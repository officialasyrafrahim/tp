@startuml
!pragma layout smetana
title Activity parameter typo validation
skinparam backgroundColor white
skinparam shadowing false
skinparam defaultFontName SansSerif
skinparam defaultFontSize 14
skinparam classAttributeIconSize 0
skinparam classBackgroundColor #EDF3F8
skinparam classBorderColor #526477
skinparam ArrowColor #526477
hide circle
hide empty members

class Parser {
  +parse(input: String): Command
}
class AddCommandParser {
  +parse(arguments: String): AddCommand
}
class EditCommandParser {
  +parse(arguments: String): EditCommand
}
class ActivityParameterValidator <<package-private utility>> {
  {static} -PARAMETER: Pattern
  {static} -PREFIXES: List<String>
  {static} -UNSUPPORTED_PREFIXES: List<String>
  {static} ~validate(arguments: String): void
  {static} ~allowsOverlap(value: String): boolean
  {static} -isOneEditAway(token: String, prefix: String): boolean
}
class ParseException <<checked exception>>

Parser ..> AddCommandParser : dispatches add
Parser ..> EditCommandParser : dispatches edit
AddCommandParser ..> ActivityParameterValidator : validates before reading fields
EditCommandParser ..> ActivityParameterValidator : validates before reading fields
ActivityParameterValidator ..> ParseException : warns about a likely misspelled prefix

note bottom of ActivityParameterValidator
  Check every slash token, including inside the first name word.
  Accept only supported prefixes at whitespace boundaries.
  Reject every unknown prefix, including single-letter tokens.
  Use edit distance only to suggest a correction.
  Literal slash text in names and slash escaping are unsupported.
end note
note bottom of ParseException
  Example: Unknown parameter 'demm/'. Did you mean 'dem/'?
  ConsoleHelper displays the warning; no command executes.
  ActivityList and saved data remain unchanged.
end note
@enduml
