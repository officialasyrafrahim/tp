@startuml
!pragma layout smetana
title Accessible route search
skinparam backgroundColor white
skinparam shadowing false
skinparam defaultFontName SansSerif
skinparam defaultFontSize 14
skinparam classAttributeIconSize 0
skinparam classBackgroundColor #EDF3F8
skinparam classBorderColor #526477
skinparam ArrowColor #526477
hide circle
hide empty members

class RouteCommand {
  +execute(...): CommandResult
}
class ConnectionManager {
  +findRoute(...): Optional<Route>
}
class DijkstraShortestPath {
  -adjacency: List<List<Node>>
  +findRoute(...): Optional<Route>
}
class DijkstraSolver {
  -distances: long[]
  -previousVertices: int[]
  -previousConnections: Connection[]
  ~computeShortestPaths(...): void
  ~getDistance(vertex: int): long
  ~getPrevious(vertex: int): int
  ~getPreviousConnection(vertex: int): Connection
}
class Route <<record>> {
  -stops: List<String>
  -distanceInMetres: long
}
class Connection {
  -from: String
  -to: String
  -distanceInMetres: int
}
enum AccessibilityStatus <<enumeration>> {
  YES
  NO
  UNKNOWN
}

RouteCommand --> ConnectionManager : connectionManager
ConnectionManager *-- DijkstraShortestPath : shortestPath
ConnectionManager --> "0..*" Connection : connections
DijkstraShortestPath ..> DijkstraSolver : creates
DijkstraShortestPath ..> Route : returns
Route --> "0..*" Connection : segments
Connection --> "1" AccessibilityStatus : accessibility

note bottom of Route
  Nested record: DijkstraShortestPath.Route
end note
@enduml
