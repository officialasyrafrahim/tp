@startuml
title Demand-ordered activity listing
skinparam backgroundColor white
skinparam shadowing false
skinparam defaultFontName SansSerif
skinparam defaultFontSize 14
skinparam ArrowColor #526477
skinparam ParticipantBackgroundColor #EDF3F8
skinparam ParticipantBorderColor #526477
skinparam sequenceMessageAlign center
hide footbox

actor "User" as User
participant "ui:Ui" as UI
participant "ConsoleHelper" as Console <<class>>
participant "parser:Parser" as Parser
participant "listParser:ListDeleteCommandParser" as ListParser
participant "activities:ActivityList" as Activities
participant "ActivityListFormatter" as Formatter <<class>>

Console -> UI : readLine()
User -> UI : list demand
UI --> Console : input

Console -> Parser : parse("list demand")
Parser -> ListParser : parseList(words)
create participant "command:ListDemandCommand" as Query
ListParser -> Query : ListDemandCommand()
ListParser --> Parser : command
Parser --> Console : command
Console -> Query : execute(activities, storage)
Query -> Activities : getDemandView()
note right of Activities
  Sort HIGH, MEDIUM, LOW; ties use date and start time.
  Row order changes; each row keeps its chronological index.
end note
Activities --> Query : view
Query -> Activities : getCanonicalView()
Activities --> Query : canonicalView
Query -> Formatter : formatDemandList(view, canonicalView)
Formatter --> Query : formatted rows or normal empty-state message
Query --> Console : CommandResult(message, false)
note over Console, UI
  didChangeActivities() is false: do not call Storage.save().
end note
Console -> UI : showMessage(result.getMessage())
UI --> User : result message
@enduml
