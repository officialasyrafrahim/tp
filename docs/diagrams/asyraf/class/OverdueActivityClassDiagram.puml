@startuml
!pragma layout smetana
title Overdue activity query
skinparam backgroundColor white
skinparam shadowing false
skinparam defaultFontName SansSerif
skinparam defaultFontSize 14
skinparam ArrowColor #526477
skinparam classAttributeIconSize 0
skinparam classBackgroundColor #EDF3F8
skinparam classBorderColor #526477
hide circle
hide empty members

abstract class Command {
  {abstract} +execute(...): CommandResult
}
class Parser {
  +parse(input: String): Command
}
class OverdueCommand {
  -clock: Clock
  +execute(...): CommandResult
}
class ActivityList {
  +getOverdueView(now: LocalDateTime): List<Activity>
  +getCanonicalView(): List<Activity>
}
class Activity {
  +getName(): String
}
class ActivityListFormatter <<utility>> {
  {static} +formatOverdueList(...): String
}
class CommandResult {
  +getMessage(): String
  +didChangeActivities(): boolean
}
Command <|-- OverdueCommand
Parser ..> OverdueCommand : creates with session clock
OverdueCommand ..> ActivityList : queries
OverdueCommand ..> ActivityListFormatter : formats
OverdueCommand ..> CommandResult : read-only result
ActivityList --> "0..*" Activity : activities
note bottom of ActivityList
  Use local now captured once by the command.
  Select incomplete activities with end strictly before now.
  Keep chronological indexes.
end note
note bottom of ActivityListFormatter
  Label today, this week or earlier.
end note
note bottom of CommandResult
  No activity changes or exit are requested.
  ConsoleHelper displays the message without saving.
end note
@enduml
