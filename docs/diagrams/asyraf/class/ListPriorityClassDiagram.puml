@startuml
!pragma layout smetana
title Priority-ordered activity listing
skinparam backgroundColor white
skinparam shadowing false
skinparam defaultFontName SansSerif
skinparam defaultFontSize 14
skinparam ArrowColor #526477
skinparam classAttributeIconSize 0
skinparam classBackgroundColor #EDF3F8
skinparam classBorderColor #526477
hide circle
hide empty members

abstract class Command {
  {abstract} +execute(...): CommandResult
}
class Parser {
  +parse(input: String): Command
}
class ListDeleteCommandParser {
  +parseList(words: String[]): Command
}
class ListPriorityCommand {
  +execute(...): CommandResult
}
class ActivityList {
  +getPriorityView(): List<Activity>
  +getCanonicalView(): List<Activity>
}
class Activity {
  +getPriorityScore(): Integer
}
class ActivityListFormatter <<utility>> {
  {static} +formatPriorityList(...): String
}
class CommandResult {
  +getMessage(): String
  +didChangeActivities(): boolean
}
Command <|-- ListPriorityCommand
Parser *-- ListDeleteCommandParser : delegates list
ListDeleteCommandParser ..> ListPriorityCommand : creates
ListPriorityCommand ..> ActivityList : queries
ListPriorityCommand ..> ActivityListFormatter : formats
ListPriorityCommand ..> CommandResult : read-only result
ActivityList --> "0..*" Activity : activities
note bottom of ActivityList
  Sort highest scores first; unavailable scores appear last.
  Include completed activities; ties use stable chronological order.
  Display full chronological indexes and NA for missing scores.
end note
note bottom of CommandResult
  No activity changes or exit are requested.
  ConsoleHelper displays the message without saving.
end note
@enduml
