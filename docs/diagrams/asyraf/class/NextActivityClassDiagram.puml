@startuml
!pragma layout smetana
title Next upcoming activity query
skinparam backgroundColor white
skinparam shadowing false
skinparam defaultFontName SansSerif
skinparam defaultFontSize 14
skinparam ArrowColor #526477
skinparam classAttributeIconSize 0
skinparam classBackgroundColor #EDF3F8
skinparam classBorderColor #526477
hide circle
hide empty members

abstract class Command {
  {abstract} +execute(...): CommandResult
}
class Parser {
  +parse(input: String): Command
}
class NextCommand {
  -clock: Clock
  +execute(...): CommandResult
}
class ActivityList {
  +getNext(now: LocalDateTime): Optional<Activity>
  +getCanonicalView(): List<Activity>
}
class Activity {
  +getName(): String
}
class ActivityListFormatter <<utility>> {
  {static} +formatNext(...): String
}
class CommandResult {
  +getMessage(): String
  +didChangeActivities(): boolean
}
Command <|-- NextCommand
Parser ..> NextCommand : creates with session clock
NextCommand ..> ActivityList : queries
NextCommand ..> ActivityListFormatter : formats
NextCommand ..> CommandResult : read-only result
ActivityList --> "0..*" Activity : activities
note bottom of ActivityList
  Use local now captured once by the command.
  Select the earliest incomplete start strictly after now.
  Equal starts retain insertion order; display the chronological index.
end note
note bottom of CommandResult
  No activity changes or exit are requested.
  ConsoleHelper displays the message without saving.
end note
@enduml
