@startuml
!pragma layout smetana
title Delete an activity using its chronological index
skinparam backgroundColor white
skinparam shadowing false
skinparam defaultFontName SansSerif
skinparam defaultFontSize 14
skinparam ArrowColor #526477
skinparam classAttributeIconSize 0
skinparam classBackgroundColor #EDF3F8
skinparam classBorderColor #526477
hide circle
hide empty members

abstract class Command {
  {abstract} +execute(...): CommandResult
}
class Parser {
  +parse(input: String): Command
}
class ListDeleteCommandParser {
  +parseDelete(words: String[]): Command
}
class DeleteCommand {
  -displayedIndex: int
  +DeleteCommand(displayedIndex: int)
  +execute(...): CommandResult
}
class ActivityList {
  +deleteByDisplayedIndex(displayedIndex: int): Activity
  +getByDisplayedIndex(displayedIndex: int): Activity
  +getCanonicalView(): List<Activity>
  +getActivities(): List<Activity>
}
class Activity {
  +getName(): String
}
class CommandResult {
  +getMessage(): String
  +didChangeActivities(): boolean
}
Command <|-- DeleteCommand
Parser *-- ListDeleteCommandParser : delegates delete
ListDeleteCommandParser ..> DeleteCommand : creates with index
DeleteCommand ..> ActivityList : removes chronological selection
DeleteCommand ..> Activity : reads removed details
DeleteCommand ..> CommandResult : requests saving
ActivityList --> "0..*" Activity : activities
note bottom of ActivityList
  Validate the index against the canonical view.
  Remove the selected object from the backing list.
  An invalid index leaves the list unchanged.
end note
note bottom of CommandResult
  Successful deletion reports an activity change, including the final deletion.
  ConsoleHelper marks it unsaved, saves, then displays the confirmation.
end note
@enduml
