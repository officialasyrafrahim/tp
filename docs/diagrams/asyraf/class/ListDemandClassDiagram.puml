@startuml
!pragma layout smetana
title Demand-ordered activity listing
skinparam backgroundColor white
skinparam shadowing false
skinparam defaultFontName SansSerif
skinparam defaultFontSize 14
skinparam ArrowColor #526477
skinparam classAttributeIconSize 0
skinparam classBackgroundColor #EDF3F8
skinparam classBorderColor #526477
hide circle
hide empty members

abstract class Command {
  {abstract} +execute(...): CommandResult
}
class Parser {
  +parse(input: String): Command
}
class ListDeleteCommandParser {
  +parseList(words: String[]): Command
}
class ListDemandCommand {
  +execute(...): CommandResult
}
class ActivityList {
  +getDemandView(): List<Activity>
  +getCanonicalView(): List<Activity>
}
class Activity {
  +getName(): String
}
class ActivityListFormatter <<utility>> {
  {static} +formatDemandList(...): String
}
class CommandResult {
  +getMessage(): String
  +didChangeActivities(): boolean
}
Command <|-- ListDemandCommand
Parser *-- ListDeleteCommandParser : delegates list
ListDeleteCommandParser ..> ListDemandCommand : creates
ListDemandCommand ..> ActivityList : queries
ListDemandCommand ..> ActivityListFormatter : formats
ListDemandCommand ..> CommandResult : read-only result
ActivityList --> "0..*" Activity : activities
note bottom of ActivityList
  Sort HIGH, MEDIUM, LOW; ties use date and start time.
  Row order changes; each row keeps its chronological index.
  Indexed changes select the activity beside that number.
end note
note bottom of CommandResult
  No activity changes or exit are requested.
  ConsoleHelper displays the message without saving.
end note
@enduml
